# Puerto HTTP (Railway lo inyecta automáticamente)
PORT=3000
# Carpeta para SQLite y caché. En Railway: ruta del volumen, p. ej. /data
DATA_DIR=./data

# URL pública de la app (para las URLs de retorno de OAuth). En Railway se deduce de RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=http://localhost:3000
# Secreto largo y aleatorio para cifrar los tokens de GitHub guardados (obligatorio en producción si hay login).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Login con Google (Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth "Aplicación web")
# URI de redirección autorizada: <PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login con GitHub e importación de repos (GitHub → Settings → Developer settings → OAuth Apps)
# Authorization callback URL: <PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional: API key gratuita de NVD (sube el límite de 5 a 50 req / 30 s)
NVD_API_KEY=
# Opcional: token de servidor para escanear repos públicos sin usuario conectado (sube el límite de 60/h)
GITHUB_TOKEN=
